# 환경 설정 예시 파일
# 실제 사용 시 .env 파일로 복사하여 사용

# 애플리케이션 환경
ENVIRONMENT=development

# AWS 설정
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_DEFAULT_LOG_BUCKET_PREFIX=s3-loglift-logs
AWS_ATHENA_DATABASE=s3_loglift_analytics
AWS_ATHENA_WORKGROUP=primary
AWS_ATHENA_OUTPUT_LOCATION=s3://s3-loglift-athena-results/
AWS_BEDROCK_MODEL_ID=anthropic.claude-opus-4-5-20251101-v1:0
AWS_BEDROCK_MAX_TOKENS=1000

# 데이터베이스 설정
DB_REDIS_URL=redis://localhost:6379
DB_REDIS_DB=0
DB_CACHE_TTL=3600

# API 서버 설정
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_RELOAD=true
API_SECRET_KEY=your-secret-key-here-change-in-production
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# 로깅 설정
LOG_LEVEL=INFO
LOG_FORMAT=json